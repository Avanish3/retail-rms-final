{
  "name": "enterprise-retail-rms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Retail Management System backend with AI-powered retail insights",
  "main": "dist/server.js",
  "engines": {
    "node": "24.14.1"
  },
  "type": "commonjs",
  "keywords": ["retail", "rms", "backend", "nodejs", "express", "typeorm"],
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start:dev": "ts-node src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:init": "ts-node src/database/init.ts",
    "seed": "ts-node src/database/seed.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.4",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "sql.js": "^1.14.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "typescript": "^5.9.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
